+    defaultValue: 'https://mvisrdmdxbenuqezprdn.supabase.co',
+  );
+
+  static const supabasePublishableKey = String.fromEnvironment(
+    'SUPABASE_PUBLISHABLE_KEY',
+    defaultValue: 'sb_publishable_5n0XY_6HBYN-xQwp5XV7eg_o7RqUQVp',
+  );
+}
