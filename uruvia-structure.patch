+        path: AppRoutes.splash,
+        builder: (_, __) => const SplashScreen(),
+      ),
+      GoRoute(
+        path: AppRoutes.home,
+        builder: (_, __) => const HomePlaceholder(),
+      ),
+    ],
+  );
+});
